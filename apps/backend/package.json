{
  "name": "@accounting-saas/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Monolith backend (NestJS) — Web/REST API process",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "dev:worker": "nest start --watch --entryFile processes/worker/worker",
    "dev:scheduler": "nest start --watch --entryFile processes/scheduler/scheduler",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/processes/worker/worker.js",
    "start:scheduler": "node dist/processes/scheduler/scheduler.js",
    "job:enqueue": "node dist/processes/cli/enqueue-sample-job.js",
    "seed": "tsc -p tsconfig.build.json && node dist/processes/seed/seed.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:status": "node dist/processes/cli/db-migrate.js status",
    "db:reset": "drizzle-kit migrate --reset",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:timezones": "for tz in UTC Asia/Tehran America/Los_Angeles; do TZ=$tz vitest run src/shared/time/jalali-calendar.spec.ts test/fiscal-boundary.e2e-spec.ts || exit 1; done",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-mysql2": "0.71.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.72.0",
    "@opentelemetry/instrumentation-redis": "0.73.0",
    "@opentelemetry/sdk-node": "0.301.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "minio": "^8.0.7",
    "mysql2": "^3.24.4",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
