{
  "name": "accounting-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent financial and accounting system — V1 monorepo root workspace",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:local": "node tooling/scripts/dev.mjs",
    "dev:backend": "pnpm --filter @accounting-saas/backend dev",
    "dev:frontend": "pnpm --filter @accounting-saas/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:check": "pnpm --filter @accounting-saas/backend deps:check",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @accounting-saas/backend seed",
    "test:backend:e2e": "pnpm --filter @accounting-saas/backend test:e2e",
    "verify": "node tooling/scripts/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "stack:up": "docker compose --profile app up -d --build",
    "stack:down": "docker compose --profile app down",
    "stack:logs": "docker compose --profile app logs -f",
    "dev:reset": "docker compose --profile app down -v",
    "storybook": "pnpm --filter @repo/storybook dev",
    "storybook:build": "pnpm --filter @repo/storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@nestjs/schematics>typescript": "5",
        "eslint-config-next>eslint": "9"
      }
    }
  }
}
