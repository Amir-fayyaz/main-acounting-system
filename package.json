{
  "name": "accounting-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent financial and accounting system — V1 monorepo root workspace",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:local": "node tooling/scripts/dev.mjs",
    "dev:backend": "pnpm --filter @accounting-saas/backend dev",
    "dev:frontend": "pnpm --filter @accounting-saas/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:check": "pnpm --filter @accounting-saas/backend deps:check",
    "test": "pnpm -r --workspace-concurrency=1 test && pnpm test:tooling",
    "test:tooling": "node --test \"tooling/scripts/**/*.test.mjs\"",
    "seed": "pnpm --filter @accounting-saas/backend seed",
    "test:backend:e2e": "pnpm --filter @accounting-saas/backend test:e2e",
    "verify": "node tooling/scripts/verify.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "obs:up": "node tooling/scripts/obs.mjs up",
    "obs:down": "node tooling/scripts/obs.mjs down",
    "obs:check": "node tooling/scripts/check-observability.mjs",
    "stack:up": "docker compose --profile app up -d --build",
    "stack:down": "docker compose --profile app down",
    "stack:logs": "docker compose --profile app logs -f",
    "dev:reset": "docker compose --profile app down -v"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-onboarding": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "catalog:",
    "globals": "^17.12.0",
    "husky": "9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "17.6.0",
    "prettier": "^3.9.9",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vitest": "catalog:"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@nestjs/schematics>typescript": "5",
        "eslint-config-next>eslint": "9"
      }
    }
  }
}
