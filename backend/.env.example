# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting_saas?schema=public

# Cache / queues (Redis)
REDIS_URL=redis://localhost:6379

# Authentication
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (comma-separated origins, * to allow all)
CORS_ORIGINS=http://localhost:3001
