# =============================================================================
# Local development environment (FND-002)
# Single source of truth for: docker compose, backend host processes,
# worker, scheduler, and NEXT_PUBLIC_* values consumed by the frontend.
# =============================================================================

# --- Runtime / environment identification -----------------------------------
# One of: development, test, production. Anything else stops the process.
NODE_ENV=development
# Identity this process reports in logs and health output.
SERVICE_NAME=backend
# One of: debug, info, warn, error.
# Set to `warn` to silence the outbox/scheduler heartbeat `info` lines
# (Job started / Job completed / Outbox batch settled / Scheduler tick).
LOG_LEVEL=warn

# --- Backend (Web / REST API) ----------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
BACKEND_API_PREFIX=/api

# --- Frontend (Next.js) ----------------------------------------------------
FRONTEND_PORT=3001
# Address the browser uses to reach the backend (must be host-reachable).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Server-side address supplied by Compose for the frontend container.
# Set it only for a host-run process that must reach the backend elsewhere.
# INTERNAL_API_BASE_URL=http://127.0.0.1:3000/api

# --- MySQL (system of record) ----------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=accounting
MYSQL_USER=accounting
# [required in production]
MYSQL_PASSWORD=dev-only-change-me
# Used by the MySQL container only, never by the application.
MYSQL_ROOT_PASSWORD=dev-only-change-me-root

# --- Redis (event bus / queue / controlled caches, never authoritative) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Object storage (MinIO, provider per TECH-008) -------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
# Development credentials only.
# [required in production]
MINIO_ACCESS_KEY=minio-local
# [required in production]
MINIO_SECRET_KEY=dev-only-change-me-minio
MINIO_BUCKET=accounting-local

# --- Worker / job execution (ADR-008, TECH-011) ----------------------------
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=30000

# --- Authentication (TECH-006, ADR-010 section 11) -------------------------
AUTH_SESSION_TTL_MINUTES=60

# --- Product Owner bootstrap (DEV-001) --------------------------------------
# Platform-wide owner of the whole product. Its `system-admin` authorization is
# platform-level: it is independent of tenant memberships and covers every
# registered capability, including companies created later. It is NOT a tenant
# administrator and is never a member of every company.
# Off by default in every environment; opt in explicitly. When enabled, the API
# provisions (or verifies) the identity before it accepts HTTP requests.
SYSTEM_ADMIN_ENABLED=false
# Required when enabled. Use a real address you control, never a seeded one.
SYSTEM_ADMIN_EMAIL=
# Required when enabled. Never commit a real value, and never reuse a
# development credential in production. `pnpm seed` needs an enabled bootstrap
# because the dataset reuses this Product Owner.
SYSTEM_ADMIN_PASSWORD=
# Display name used only when the identity is first created (default below).
SYSTEM_ADMIN_DISPLAY_NAME=Product Owner

# --- Development/test seeding (DEV-001) -------------------------------------
# The dataset is created only by the explicit command below, never at startup,
# and only when NODE_ENV is `development` or `test`:
#   pnpm --filter @accounting-saas/backend db:migrate   # includes seed_fixtures
#   pnpm seed                                            # first run creates fixtures
#   pnpm seed                                            # second run reuses them
# Seeded users sign in with the fixture password `Seed-user-password-1!`.
# There is no seeding setting here on purpose: no environment variable can
# enable seeding in production.

# --- Scheduler (ADR-008, section 9) ----------------------------------------
# How often the scheduler promotes due retries and periodic triggers.
# Quiet dev: every 10 s. Outbox tick (below) is the only thing this wakes.
SCHEDULER_INTERVAL_MS=10000

# --- Transactional outbox (ADR-004, ADR-005 section 7) ---------------------
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
# How often the scheduler enqueues an outbox.publish tick.
# Quiet dev: every 30 s. With LOG_LEVEL=warn the "Outbox batch settled"
# line is silent, so you only see real work (retries, publishes).
OUTBOX_PUBLISH_INTERVAL_MS=30000