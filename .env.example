
# --- Runtime / environment identification ----------------------------------
# One of: development, test, production. Anything else stops the process.
NODE_ENV=development
# Identity this process reports in logs and health output. The worker and
# scheduler processes will set their own value (worker, scheduler) while reading
# the rest of this file unchanged.
SERVICE_NAME=backend
# One of: debug, info, warn, error. Controls the backend log verbosity.
LOG_LEVEL=info

# --- Backend (Web / REST API) ----------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
BACKEND_API_PREFIX=/api

# --- Frontend (Next.js) ----------------------------------------------------
FRONTEND_PORT=3001
# Address the browser uses to reach the backend (must be host-reachable).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Server-side address is supplied by Compose for the frontend container
# (http://backend:3000/api). Set it only for a host-run process that must reach
# the backend through a different address.
# INTERNAL_API_BASE_URL=http://127.0.0.1:3000/api

# --- MySQL (system of record) ----------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=accounting
MYSQL_USER=accounting
# [required in production]
MYSQL_PASSWORD=dev-only-change-me
# Used by the MySQL container only, never by the application.
MYSQL_ROOT_PASSWORD=dev-only-change-me-root

# --- Redis (event bus / queue / controlled caches, never authoritative) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Object storage (MinIO, provider per TECH-008) -------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
# Development credentials only. They must be changed for any shared environment.
# [required in production]
MINIO_ACCESS_KEY=minio-local
# [required in production]
MINIO_SECRET_KEY=dev-only-change-me-minio
MINIO_BUCKET=accounting-local

# --- Worker / job execution (ADR-008, TECH-011) ----------------------------
# Consumed by the background worker process; validated for every process so they
# share one configuration contract.
# How many jobs one worker process executes at a time.
WORKER_CONCURRENCY=4
# Upper bound of attempts for a failing job before it is parked as failed.
WORKER_MAX_ATTEMPTS=3
# First retry backoff in milliseconds; it doubles per attempt up to the ceiling.
WORKER_RETRY_BASE_DELAY_MS=1000
# Ceiling of the exponential backoff, so a retry never waits unbounded.
WORKER_RETRY_MAX_DELAY_MS=30000

# --- Authentication (TECH-006, ADR-010 section 11) --------------------------
# Validated by every process so the contract is shared. No secret is defaulted
# here: the password hash cost parameters are an engineering decision owned by
# the implementation, and sessions carry randomly generated tokens.
# How long an authenticated session stays valid after sign-in, in minutes.
AUTH_SESSION_TTL_MINUTES=60

# --- Scheduler (ADR-008, section 9) ----------------------------------------
# How often the scheduler process promotes due retries and periodic triggers.
SCHEDULER_INTERVAL_MS=1000

# --- Transactional outbox (ADR-004, ADR-005 section 7) ----------------------
# Consumed by every process (validated once, shared contract); only the worker
# and scheduler act on them. Defaults shown; remove a line to use the default.
# How many due outbox records one publisher run claims at most.
OUTBOX_BATCH_SIZE=25
# Attempts per record before it parks as failed (kept for manual recovery).
OUTBOX_MAX_ATTEMPTS=5
# First backoff after a transient publication failure; doubles per attempt.
OUTBOX_RETRY_BASE_DELAY_MS=1000
# Ceiling of that backoff (must be >= the base delay).
OUTBOX_RETRY_MAX_DELAY_MS=60000
# How often the scheduler enqueues an outbox.publish tick.
OUTBOX_PUBLISH_INTERVAL_MS=1000
