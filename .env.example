# ---------------------------------------------------------------------------
# Base environment configuration for local development.
#
# Copy this file to `.env` in the repository root and adjust the values:
#   cp .env.example .env
#
# The repository-root `.env` is consumed by:
#   - docker compose            (MySQL / Redis / MinIO containers)
#   - the backend process       (loads ../../.env when run from apps/backend)
#
# The frontend only needs public values; to override them for the frontend
# process, create `apps/frontend/.env.local` with the `NEXT_PUBLIC_*` keys.
# `.env` files are git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Backend (HTTP API) ----------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
# Base path for the REST API (versioned at the transport boundary).
BACKEND_API_PREFIX=/api

# --- Database (MySQL 8.4) --------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=accounting
MYSQL_USER=accounting
MYSQL_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-development-root-only

# --- Redis (internal event bus / queue) ------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- File storage (MinIO) --------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio-local
MINIO_SECRET_KEY=minio-local-secret
MINIO_BUCKET=accounting-local

# --- Frontend --------------------------------------------------------------
# Public base URL of the REST API used by the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api
