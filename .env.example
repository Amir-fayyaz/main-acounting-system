# ---------------------------------------------------------------------------
# Local development environment (FND-002)
#
#   cp .env.example .env
#
# This file is the single source of environment values for:
#   - docker compose              (infrastructure, and the optional `app` profile)
#   - the backend on the host     (`pnpm dev`)
#   - the frontend on the host    (`NEXT_PUBLIC_*` values)
#
# HOST PORTS vs CONTAINER PORTS
#   Every *_PORT value below is a HOST port. Inside the Compose network services
#   always listen on their standard ports (MySQL 3306, Redis 6379, MinIO 9000)
#   and the app containers receive those addresses from Compose itself, so this
#   file never needs to know about service names.
#
# ADDRESSES
#   Hosts are 127.0.0.1 because the applications run on the host by default.
#   Change NEXT_PUBLIC_API_BASE_URL if the browser reaches the backend through a
#   different address (remote dev server, another port).
#
# SECRETS
#   The values below are development-only placeholders and `.env` is git-ignored.
#   Production credentials come from the deployment's secret mechanism and are
#   never committed (Engineering Principles, rule 10).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- Backend (Web / REST API) ----------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
BACKEND_API_PREFIX=/api

# --- Frontend (Next.js) ----------------------------------------------------
FRONTEND_PORT=3001
# Address the browser uses to reach the backend (must be host-reachable).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Server-side address is supplied by Compose for the frontend container
# (http://backend:3000/api). Set it only for a host-run process that must reach
# the backend through a different address.
# INTERNAL_API_BASE_URL=http://127.0.0.1:3000/api

# --- MySQL (system of record) ----------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=accounting
MYSQL_USER=accounting
MYSQL_PASSWORD=dev-only-change-me
MYSQL_ROOT_PASSWORD=dev-only-change-me-root

# --- Redis (event bus / queue / controlled caches, never authoritative) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Object storage (MinIO, provider per TECH-008) -------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
# Development credentials only. They must be changed for any shared environment.
MINIO_ACCESS_KEY=minio-local
MINIO_SECRET_KEY=dev-only-change-me-minio
MINIO_BUCKET=accounting-local
